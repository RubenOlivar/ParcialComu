# =============================================================================
#  Parcial 2 practico - Comunicaciones (Ing. Mecatronica - UMNG)
#  Variables de entorno preconfiguradas.  Uso:   cp .env.example .env
#  Todos los valores ya son funcionales: NO requiere edicion para evaluar.
# =============================================================================

# ---------------------------- PostgreSQL (database) --------------------------
POSTGRES_DB=joomladb
POSTGRES_USER=joomla
POSTGRES_PASSWORD=Comm2026_Postgres

# Rol de SOLO LECTURA que usa Grafana para consultar logs y metricas.
GRAFANA_DB_USER=grafana_ro
GRAFANA_DB_PASSWORD=Comm2026_GrafanaRO

# ------------------------------- Joomla (CMS) --------------------------------
# JOOMLA_DB_TYPE debe ser pgsql para que el CMS use PostgreSQL como motor.
JOOMLA_DB_TYPE=pgsql
JOOMLA_DB_PREFIX=joom_

# Credenciales de instalacion desatendida del portal.
# Restricciones de la imagen oficial: usuario solo alfabetico, clave > 12 caracteres.
JOOMLA_SITE_NAME=Portal Institucional UMNG - Comunicaciones
JOOMLA_ADMIN_USER=Administrador UMNG
JOOMLA_ADMIN_USERNAME=administrador
JOOMLA_ADMIN_PASSWORD=Comm2026_Joomla_Admin
JOOMLA_ADMIN_EMAIL=admin@umng.local

# ------------------------------- Grafana -------------------------------------
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=Comm2026_Grafana
# Host publico por el que se accede al proxy (cambiar solo si no es localhost).
PUBLIC_HOST=localhost

# ------------------------------- Plataforma ----------------------------------
# Puerto publicado por Nginx en el host (unico puerto expuesto del stack).
HTTP_PORT=80
TZ=America/Bogota
