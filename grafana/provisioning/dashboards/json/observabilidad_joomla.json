          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pg_observabilidad"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT date_trunc('minute', \"time\") AS \"time\",\n       percentile_cont(0.50) WITHIN GROUP (ORDER BY duracion_s) AS \"p50\",\n       percentile_cont(0.95) WITHIN GROUP (ORDER BY duracion_s) AS \"p95\"\nFROM observabilidad.nginx_access\nWHERE $__timeFilter(\"time\")\nGROUP BY 1\nORDER BY 1;"
        }
      ]
