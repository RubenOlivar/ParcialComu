          "format": "table",
          "rawSql": "SELECT ip_cliente                            AS \"IP cliente\",\n       count(*)                              AS \"Peticiones\",\n       count(*) FILTER (WHERE status >= 400) AS \"Errores\",\n       max(\"time\")                           AS \"Ultima peticion\"\nFROM observabilidad.nginx_access\nWHERE $__timeFilter(\"time\")\nGROUP BY 1\nORDER BY 2 DESC\nLIMIT 10;"
        }
      ]
    },
