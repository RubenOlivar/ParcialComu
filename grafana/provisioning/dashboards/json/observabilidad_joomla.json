{
  "uid": "parcial2-observabilidad",
  "title": "Observabilidad del portal Joomla (edge Nginx + PostgreSQL)",
  "description": "Paneles aprovisionados automaticamente. Todas las series provienen de las vistas SQL del esquema 'observabilidad', que parsean los access logs JSON de Nginx y de Apache/Joomla, mas las estadisticas del propio motor PostgreSQL.",
  "tags": [
    "parcial2",
    "comunicaciones",
    "umng",
    "joomla",
    "nginx"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "10s",
      "30s",
      "1m",
      "5m",
      "15m"
    ]
  },
  "annotations": {
    "list": []
  },
  "templating": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Peticiones atendidas por el edge",
      "description": "Total de peticiones HTTP registradas por Nginx en el rango seleccionado.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pg_observabilidad"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "#3987e5"
          },
          "unit": "short",
          "decimals": 0,
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pg_observabilidad"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT count(*) AS \"Peticiones\"\nFROM observabilidad.nginx_access\nWHERE $__timeFilter(\"time\");"
        }
      ]
    },
    {
